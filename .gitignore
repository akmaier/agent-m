# Build output of the GitHub Pages site
/_site/
/dist/
/node_modules/

# Nothing configuration-related is ever committed (SPEC.md §0 NO SECRET IN THE REPOSITORY)
.env
.env.*
*.key
*.pem
config.local.*

# Editor / OS noise
.DS_Store
.venv/
__pycache__/
*.pyc

# Product clones in a local checkout (SPEC §10 A LOCAL CLONE HOLDS ITS PRODUCTS IN ITS PRODUCTS FOLDER)
/products/*
!/products/README.md

# The Bridge app's installed packages (MOD-bridge-build: npm install --prefix src/bridge-build)
/src/bridge-build/node_modules/
