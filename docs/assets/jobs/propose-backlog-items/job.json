{
  "kind": "propose-backlog-items",
  "role": "Product Owner",
  "capabilities": ["draft text"],
  "inputs": ["requirements", "useCases", "items"],
  "output": {
    "type": "object",
    "required": ["items"],
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["title", "outcome", "realises"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "outcome": { "type": "string", "minLength": 1 },
            "realises": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "acceptance": { "type": "string" }
          }
        }
      }
    }
  },
  "checks": ["itemProblems"],
  "rounds": 3,
  "result": "commit"
}
